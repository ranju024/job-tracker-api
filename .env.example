DATABASE_URL=postgresql://<DBUsername>:<YourDBPassword>@localhost:5432/jobtracker
SECRET_KEY=django_secret_key
DEBUG=True

# Only enforced when DEBUG=False.
# For production: ALLOWED_HOSTS=api.yourdomain.com
